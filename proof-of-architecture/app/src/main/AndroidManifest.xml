<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only for talking to the runtime's own 127.0.0.1 WebSocket/HTTP server, never a remote host. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".ProofOfArchitectureApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Cortana PoA 0.5"
        android:theme="@style/Theme.ProofOfArchitecture"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Cortana PoA 0.5">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.williamguillon.cortana.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
